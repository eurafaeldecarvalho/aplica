{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/eurafaeldecarvalho/aplica/profile.schema.json",
  "title": "Aplica profile.json",
  "description": "Dados do candidato, preenchidos na aba 'Meus dados' do app. Nunca versionado. O motor lê daqui para preencher formulários de candidatura. Respostas abertas longas podem ficar em answers.md.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "identity": {
      "type": "object",
      "description": "Seção 1 — identidade.",
      "properties": {
        "full_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone_e164": { "type": "string", "description": "Telefone em E.164, ex.: +5541999999999." },
        "birth_date": { "type": "string" },
        "national_id": { "type": "string", "description": "Documento nacional, se o usuário quiser guardar (opcional; evite dados sensíveis em repos)." },
        "nationality": { "type": "string" }
      }
    },
    "address": {
      "type": "object",
      "description": "Seção 2 — endereço.",
      "properties": {
        "line1": { "type": "string" }, "city": { "type": "string" },
        "state": { "type": "string" }, "country": { "type": "string" }, "postal_code": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "description": "Seção 3 — links.",
      "properties": {
        "linkedin": { "type": "string" }, "github": { "type": "string" },
        "portfolio": { "type": "string" }, "other": { "type": "array", "items": { "type": "string" } }
      }
    },
    "work_authorization": {
      "type": "object",
      "description": "Seção 4 — autorização de trabalho.",
      "properties": {
        "authorized_countries": { "type": "array", "items": { "type": "string" } },
        "needs_sponsorship": { "type": "boolean" },
        "disability": { "type": "string" },
        "veteran": { "type": "string" },
        "contact_current_employer": { "type": "boolean" }
      }
    },
    "eeo": {
      "type": "object",
      "description": "Seção 5 — autodeclaração (opcional, nunca inventar).",
      "properties": {
        "gender": { "type": "string" }, "pronouns": { "type": "string" },
        "race": { "type": "string" }, "self_identification": { "type": "string" }
      }
    },
    "preferences": {
      "type": "object",
      "description": "Seção 6 — cargo, modalidade e salário.",
      "properties": {
        "headline": { "type": "string" },
        "seniority": { "type": "string" },
        "work_model": { "type": "string" },
        "contract_types": { "type": "array", "items": { "type": "string" } },
        "salary": {
          "type": "object",
          "description": "Pretensão por modalidade (nunca em branco, nunca lowball).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "currency": { "type": "string" },
              "period": { "enum": ["month", "year", "hour"] },
              "min": { "type": "number" }, "mid": { "type": "number" }, "max": { "type": "number" }
            }
          }
        },
        "start_availability": { "type": "string" },
        "notice_period": { "type": "string" }
      }
    },
    "experience": {
      "type": "object",
      "description": "Seção 7 — experiência.",
      "properties": {
        "total_years": { "type": "number" },
        "current_role": { "type": "string" },
        "stacks": { "type": "array", "items": { "type": "string" } },
        "bio": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Bios por idioma, ex.: {\"en\": \"...\", \"pt\": \"...\"}." },
        "years_by_tech": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Matriz de anos por tecnologia (não arredondar pra cima)." }
      }
    },
    "languages": {
      "type": "array",
      "description": "Seção 8 — idiomas.",
      "items": {
        "type": "object",
        "properties": { "language": { "type": "string" }, "level": { "type": "string" } }
      }
    },
    "education": {
      "type": "array",
      "description": "Seção 9 — formação, cursos, certificações (com credential id).",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["degree", "course", "certification"] },
          "title": { "type": "string" }, "institution": { "type": "string" },
          "year": { "type": "string" }, "status": { "type": "string" }, "credential_id": { "type": "string" }
        }
      }
    },
    "open_answers": {
      "type": "object",
      "description": "Seção 10 — respostas abertas reutilizáveis (pitch, motivação, etc.) e estilo de escrita.",
      "properties": {
        "pitch": { "type": "string" },
        "writing_style": { "type": "string", "description": "Como escrever em nome do usuário (nível de idioma, voz)." },
        "qa": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "references": {
      "type": "array",
      "description": "Seção 11 — referências (não inventar; vazio se não houver).",
      "items": { "type": "object", "properties": { "name": { "type": "string" }, "contact": { "type": "string" } } }
    }
  }
}
