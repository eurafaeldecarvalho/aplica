{
  "name": "aplica",
  "version": "0.1.1",
  "description": "Aplica — desktop cockpit for the auto-apply job search plugin for Claude Code. Onboarding, your-data form, toggles, schedule and dashboard. Windows + Linux.",
  "author": "Rafael de Carvalho <rafaeldecarvalho.ps@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/eurafaeldecarvalho/aplica",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/hanken-grotesk": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.7.0",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.5.3",
    "vite": "5.3.3"
  },
  "build": {
    "appId": "com.github.eurafaeldecarvalho.aplica",
    "productName": "Aplica",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      { "from": "engine", "to": "engine", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "Aplica-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "Rafael de Carvalho <rafaeldecarvalho.ps@gmail.com>",
      "artifactName": "Aplica-${version}.${ext}"
    }
  }
}
